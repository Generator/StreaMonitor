# StreaMonitor Configuration

# Directory to save downloads
STRMNTR_DOWNLOAD_DIR=downloads

# Minimum free disk space percentage required before pausing downloads
STRMNTR_MIN_FREE_SPACE=5.0

# Enable debug mode
STRMNTR_DEBUG=false

# Path structure: plain or nested
# plain: downloads/username [CS]/username-20240413-143022.mp4
# nested: downloads/Site/username/username-20240413-143022.mp4
STRMNTR_PATH_TYPE=plain

# HTTP User-Agent string
STRMNTR_USER_AGENT="Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:135.0) Gecko/20100101 Firefox/135.0"

# Path to ffmpeg binary (default: ffmpeg on PATH)
STRMNTR_FFMPEG_PATH=ffmpeg

# Preferred video resolution (240, 360, 480, 720, 1080, 1440, 99999 for highest)
STRMNTR_RESOLUTION=1080

# Resolution matching strategy: exact, exact_or_least_higher, exact_or_highest_lower, closest
STRMNTR_RESOLUTION_PREF=closest

# Output container format (mkv or mp4)
STRMNTR_CONTAINER=mp4

# Add VR format suffix to filenames
STRMNTR_VR_FORMAT_SUFFIX=true

# FFmpeg readrate (0, 1, or 1.3 - 1.3 recommended)
STRMNTR_FFMPEG_READRATE=1.3

# Segment time in seconds or hh:mm:ss format (leave empty for single file)
STRMNTR_SEGMENT_TIME=

# Web server bind address (0.0.0.0 for remote access)
STRMNTR_HOST=127.0.0.1

# Web server port
STRMNTR_PORT=5000

# Web UI skin: truck-kun (default), shaftoverflow
STRMNTR_SKIN=truck-kun

# Streamer list update frequency in seconds
STRMNTR_LIST_FREQ=30

# Streamer status update frequency in seconds on recording page
STRMNTR_STATUS_FREQ=5

# Enable theater mode
STRMNTR_THEATER_MODE=false

# Confirm deletes: empty (disabled), MOBILE (mobile only), or any value (always)
STRMNTR_CONFIRM_DEL=MOBILE

# Web server password (leave empty for no auth, username is admin)
STRMNTR_PASSWORD=admin